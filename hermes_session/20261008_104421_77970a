ort pandas as pd\\n15|\\n16|from spx_momentum.config import Settings\\n17|from spx_momentum.data.store import Stage\\n18|\\n19|if TYPE_CHECKING:  # typing only (store never imports momentum; no cycle)\\n20|    from spx_momentum.data.store import LakeStore\\n21|\\n22|#: Average US trading month; converts plan \\\"months\\\" to row offsets on daily data.\\n23|TRADING_DAYS_PER_MONTH = 21\\n24|\\n25|#: Blend weights from the plan (Task 7 pseudocode) — 12m-dominant classic blend.\\n26|SCORE_WEIGHTS: tuple[tuple[str, float], ...] = (\\n27|    (\\\"ret_12m\\\", 0.5),\\n28|    (\\\"ret_6m\\\", 0.3),\\n29|    (\\\"ret_3m\\\", 0.2),\\n30|)\\n31|\\n32|\\n33|def _long_frame(panel: pd.DataFrame, value_name: str) -> pd.DataFrame:\\n34|    \\\"\\\"\\\"Panel (index=date, cols=ticker) -> long rows (date, ticker, value).\\\"\\\"\\\"\\n35|    body = panel.rename_axis(\\\"date\\\").reset_index()\\n36|    long = body.melt(id_vars=\\\"date\\\", var_name=\\\"ticker\\\", value_name=value_name)\\n37|    return long[[\\\"date\\\", \\\"ticker\\\", value_name]]\\n38|\\n39|\\n40|def _as_panel(prices: pd.DataFrame) -> pd.DataFrame:\\n41|    \\\"\\\"\\\"Accept either shape: the CLEAN long frame (ticker/date/adj_close) or an\\n42|    already-pivoted panel (index=date, cols=ticker, values=adjusted close).\\\"\\\"\\\"\\n43|    if {\\\"ticker\\\", \\\"date\\\", \\\"adj_close\\\"}.issubset(prices.columns):\\n44|        long = prices[[\\\"date\\\", \\\"ticker\\\", \\\"adj_close\\\"]].drop_duplicates(\\n45|            subset=[\\\"date\\\", \\\"ticker\\\"], keep=\\\"last\\\"\\n46|        )\\n47|        return long.pivot(index=\\\"date\\\", columns=\\\"ticker\\\", values=\\\"adj_close\\\")\\n48|    if not isinstance(prices.index, pd.DatetimeIndex):\\n49|        raise ValueError(\\\"build_features: panel input must be indexed by date\\\")\\n50|    return prices\\n51|\\n52|\\n53|def rolling_returns(\\n54|    prices: pd.DataFrame,\\n55|    months: tuple[int, ...] = (3, 6, 12),\\n56|    skip_months: int = 1,\\n57|) -> pd.DataFrame:\\n58|    \\\"\\\"\\\"Per-ticker rolling returns, dropping the most recent `skip_months`\\n59|    months of each window (classic 12-1).\\n60|\\n61|    - Input: panel, index=date, cols=ticker, values=adjusted close.\\n62|    - Window for `m`: rows [t - (skip+m)*D, t - skip*D] with D =\\n63|      TRADING_DAYS_PER_MONTH — the most recent month is excluded entirely;\\n64|      skip_months=0 gives the plain m-month return.\\n65|    - Output: long frame (date, ticker, ret_3m, ret_6m, ret_12m — one ret\\n66|      column per entry of `months`); leading rows are NaN (insufficient\\n67|      history). Deterministic: pure arithmetic + shifts on the input.\\n68|    \\\"\\\"\\\"\\n69|    if prices.empty:\\n70|        raise ValueError(\\\"rolling_returns: empty price panel\\\")\\n71|    if not months:\\n72|        raise ValueError(\\\"rolling_returns: `months` must be non-empty\\\")\\n73|    d = TRADING_DAYS_PER_MONTH\\n74|    end_shift = skip_months * d\\n75|    parts: list[pd.DataFrame] = []\\n76|    for m in months:\\n77|        ret = prices.shift(end_shift) / prices.shift(end_shift + m * d) - 1\\n78|        parts.append(_long_frame(ret, f\\\"ret_{m}m\\\"))\\n79|    out = parts[0]\\n80|    for part in parts[1:]:\\n81|        out = out.merge(part, on=[\\\"date\\\", \\\"ticker\\\"], how=\\\"inner\\\")\\n82|    return out.sort_values([\\\"date\\\", \\\"ticker\\\"]).reset_index(drop=True)\\n83|\\n84|\\n85|def cross_sectional_scores(ret: pd.DataFrame) -> pd.DataFrame:\\n86|    \\\"\\\"\\\"Per-date cross-sectional rank blend into one score column.\\n87|\\n88|    - Input: long frame from rolling_returns (date, ticker, ret_*m columns).\\n89|    - rank(pct=True) across tickers within each date (ties averaged — the\\n90|      deterministic 'average' method), blended by SCORE_WEIGHTS\\n91|      (0.5/0.3/0.2 — plan Task 7).\\n92|    - Output: long frame (date, ticker, score) with scores in [0, 1]; a date\\n93|      whose tickers all lack history scores NaN. Reproducible: two runs on the\\n94|      same input yield bit-identical frames (no timestamps, no randomness).\\n95|    \\\"\\\"\\\"\\n96|    missing = [col for col, _ in SCORE_WEIGHTS if col not in ret.columns]\\n97|    if missing:\\n98|        raise ValueError(f\\\"cross_sectional_scores: missing return columns {missing}\\\")\\n99|    if ret[[\\\"date\\\", \\\"ticker\\\"]].duplicated().any():\\n100|        raise ValueError(\\\"cross_sectional_scores: duplicate (date, ticker) rows\\\")\\n101|    ranked: dict[str, pd.Series] = {}\\n102|    for col, _ in SCORE_WEIGHTS:\\n103|        grouped = ret.groupby(\\\"date\\\", sort=False)[col]\\n104|        ranked[col] = grouped.rank(pct=True, method=\\\"average\\\")\\n105|    score = sum(weight * ranked[col] for col, weight in SCORE_WEIGHTS)\\n106|    out = pd.DataFrame({\\\"date\\\": ret[\\\"date\\\"], \\\"ticker\\\": ret[\\\"ticker\\\"]})\\n107|    out[\\\"score\\\"] = score.to_numpy()\\n108|    return out\\n109|\\n110|\\n111|def build_features(\\n112|    prices: pd.DataFrame,\\n113|    store: object,\\n114|    cfg: Settings,\\n115|) -> pd.DataFrame:\\n116|    \\\"\\\"\\\"Compute rolling_returns + cross_sectional_scores and upsert into\\n117|    Stage.FEATURES (keyed (ticker, date) — an idempotent rerun is a no-op on\\n118|    row count).\\n119|\\n120|    - `prices`: either the CLEAN long frame (ticker/date/adj_close) as the\\n121|      pipeline passes it, or a price panel (index=date, cols=ticker).\\n122|    - Returns the score frame in the wide ruling shape (SDD ledger T7):\\n123|      index=date, cols=ticker, blended score.\\n124|    \\\"\\\"\\\"\\n125|    panel = _as_panel(prices)\\n126|    ret = rolling_returns(panel, months=(3, 6, 12), skip_months=cfg.skip_months)\\n127|    scores = cross_sectional_scores(ret)\\n128|    cast(\\\"LakeStore\\\", store).write_upsert(scores, Stage.FEATURES, key_cols=(\\\"ticker\\\", \\\"date\\\"))\\n129|    wide = scores.pivot(index=\\\"date\\\", columns=\\\"ticker\\\", values=\\\"score\\\")\\n1