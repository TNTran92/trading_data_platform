# Precedence (highest first): kwarg overrides > SPX_* env vars > yaml baseline\\n4|# > field defaults. A missing/invalid value raises a typed pydantic\\n5|# ValidationError, never a crash.\\n6|from __future__ import annotations\\n7|\\n8|import os\\n9|from collections.abc import Mapping\\n10|from pathlib import Path\\n11|from typing import Any\\n12|\\n13|import yaml\\n14|from pydantic_settings import BaseSettings, SettingsConfigDict\\n15|\\n16|#: src/spx_momentum/config.py -> up three = repo root, holding config/default.yaml.\\n17|_REPO_ROOT = Path(__file__).resolve().parents[2]\\n18|DEFAULT_YAML = _REPO_ROOT / \\\"config\\\" / \\\"default.yaml\\\"\\n19|\\n20|\\n21|class Settings(BaseSettings):\\n22|    \\\"\\\"\\\"Defaults mirror config/default.yaml; SPX_* env and kwargs win.\\\"\\\"\\\"\\n23|\\n24|    model_config = SettingsConfigDict(env_prefix=\\\"SPX_\\\", extra=\\\"allow\\\")\\n25|\\n26|    universe_source: str = \\\"wikipedia\\\"\\n27|\\n28|    # strategy\\n29|    top_n: int = 20\\n30|    lookback_months: int = 12\\n31|    skip_months: int = 1  # classic 12-1 momentum\\n32|    rebalance: str = \\\"last_trading_day\\\"\\n33|\\n34|    # cost model (one-way, on traded notional)\\n35|    cost_bps: float = 5.0\\n36|    slippage_bps: float = 5.0\\n37|\\n38|    # layout\\n39|    data_root: Path = Path(\\\"data\\\")\\n40|    artifacts_dir: Path = Path(\\\"artifacts\\\")\\n41|\\n42|    # validation gates (transform fails loudly beyond these)\\n43|    null_ratio_max: float = 0.20\\n44|    coverage_min: float = 0.95\\n45|\\n46|    # ingest tuning\\n47|    fetch_chunk_size: int = 25\\n48|    fetch_retries: int = 3\\n49|    fetch_backoff_s: float = 2.0\\n50|\\n51|\\n52|def _load_yaml(path: Path) -> dict[str, object]:\\n53|    with path.open(\\\"r\\\", encoding=\\\"utf-8\\\") as fh:\\n54|        loaded = yaml.safe_load(fh)\\n55|    return loaded if isinstance(loaded, dict) else {}\\n56|\\n57|\\n58|def _env_overrides(for_fields: Mapping[str, object] | None = None) -> dict[str, str]:\\n59|    \\\"\\\"\\\"SPX_<FIELD> env vars for known fields (only set ones, exact match).\\n60|\\n61|    Unknown SPX_* env vars are ignored so a stray variable can't create an\\n62|    unexpected extra field.\\n63|    \\\"\\\"\\\"\\n64|    overrides: dict[str, str] = {}\\n65|    for name in for_fields if for_fields is not None else Settings.model_fields:\\n66|        value = os.environ.get(f\\\"SPX_{name.upper()}\\\")\\n67|        if value is not None:\\n68|            overrides[name] = value\\n69|    return overrides\\n70|\\n71|\\n72|def load_settings(path: str | Path | None = None, **overrides: object) -> Settings:\\n73|    \\\"\\\"\\\"yaml baseline -> SPX_* env -> kwarg overrides -> validated Settings.\\n74|\\n75|    Raises a typed pydantic ValidationError on missing required fields or\\n76|    wrongly-typed values (e.g. top_n=\\\"abc\\\").\\n77|    \\\"\\\"\\\"\\n78|    base = _load_yaml(Path(path) if path is not None else DEFAULT_YAML)\\n79|    merged: dict[str, Any] = {**base, **_env_overrides(), **overrides}\\n80|    return Settings(**merged)\\n81|\\n82|\\n83|settings = load_settings()\", \"total_lines\": 83, \"file_size\": 2672, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "tool_call_id": "call_7iulsz1p", "tool_calls": null, "tool_name": "read_file", "effect_disposition": null, "timestamp": 1791474416.819601, "token_count": null, "finish_reason": null, "reasoning": null, "reasoning_content": null, "reasoning_details": null, "codex_reasoning_items": null, "codex_message_items": null, "platform_message_id": null, "observed": 0, "active": 1, "compacted": 0, "api_content": null, "display_kind": null, "display_metadata": null, "message_uid": "7ebc35a436b147c5b5da166630e03aa2", "absorbed_message_uids": null, "tool_call_uids": null, "tool_call_uid": "e37d6ae42914494bbb7c9156b90ddb73"}, {"id": 968, "session_id": "20261008_104421_77970a", "role": "tool", "content": "{\"content\": \"1|# Momentum features: 3/6/12-mo rolling returns with 1-month skip, cross-\\n2|# sectional rank scores (DESIGN-DOC §4.2; scaffold plan Task 7).\\n3|#\\n4|# Pure pandas; deterministic (no randomness, no network, no wall-clock).\\n5|#\\n6|# Frequency unit: prices are daily, so 1 month = TRADING_DAYS_PER_MONTH rows\\n7|# (the average US trading month). The classic 12-1 boundary: ret_m measures\\n8|# the window ending `skip_months` months ago (the most recent month excluded)\\n9|# and spanning `m` months before that.\\n10|from __future__ import annotations\\n11|\\n12|from typing import TYPE_CHECKING, cast\\n13|\\n14|import pandas as pd\\n15|\\n16|from spx_momentum.config import Settings\\n17|from spx_momentum.data.store import Stage\\n18|\\n19|if TYPE_CHECKING:  # typing only (store never imports momentum; no cycle)\\n20|    from spx_momentum.data.store import LakeStore\\n21|\\n22|#: Average US trading month; converts plan \\\"months\\\" to row offsets on daily data.\\n23|TRADING_DAYS_PER_MONTH = 21\\n24|\\n25|#: Blend weights from the plan (Task 7 pseudocode) — 12m-dominant classic blend.\\n26|SCORE_WEIGHTS: tuple[tuple[str, float], ...] = (\\n27|    (\\\"ret_12m\\\", 0.5),\\n28|    (\\\"ret_6m\\\", 0.3),\\n29|    (\\\"ret_3m\\\", 0.2),\\n30|)\\n31|\\n32|\\n33|def _long_frame(panel: pd.DataFrame, value_name: str) -> pd.DataFrame:\\n34|    \\\"\\\"\\\"Panel (index=date, cols=ticker) -> long rows (date, ticker, value).\\\"\\\"\\\"\\n35|    body = panel.rename_axis(\\\"date\\\").reset_index()\\n36|    long = body.melt(id_vars=\\\"date\\\", var_name=\\\"ticker\\\", value_name=value_name)\\n37|    return long[[\\\"date\\\", \\\"ticker\\\", value_name]]\\n38|\\n39|\\n40|def _as_panel(prices: pd.DataFrame) -> pd.DataFrame:\\n41|    \\\"\\\"\\\"Accept either shape: the CLEAN long frame (ticker/date/adj_close) or an\\n42|    already-pivoted panel (index=date, cols=ticker, values=adjusted close).\\\"\\\"\\\"\\n43|    if {\\\"ticker\\\", \\\"date\\\", \\\"adj_close\\\"}.issubset(prices.columns):\\n44|        long = prices[[\\\"date\\\", \\\"ticker\\\", \\\"adj_close\\\"]].drop_duplicates(\\n45|            subset=[\\\"date\\\", \\\"ticker\\\"], keep=\\\"last\\\"\\n46|        )\\n47|        return long.pivot(index=\\\"date\\\", columns=\\\"ticker\\\", values=\\\"adj_close\\\")\\n48|    if not isinstance(prices.index, pd.DatetimeIndex):\\n49|        raise ValueError(\\\"build_features: panel input must be indexed by date\\\")\\n50|    return prices\\n51|\\n52|\\n53|def rolling_returns(\\n54|    prices: pd.DataFrame,\\n55|    months: tuple[int, ...] = (3, 6, 12),\\n56|    skip_months: int = 1,\\n57|) -> pd.DataFrame:\\n58|    \\\"\\\"\\\"Per-ticker rolling returns, dropping the most recent `skip_months`\\n59|    months of each window (classic 12-1).\\n60|\\n61|    - Input: panel, index=date, cols=ticker, values=adjusted close.\\n62|    - Window for `m`: rows [t - (skip+m)*D, t - skip*D] with D =\\n63|      TRADING_DAYS_PER_MONTH — the most recent month is excluded entirely;\\n64|      skip_months=0 gives the plain m-month return.\\n65|    - Output: long frame (date, ticker, ret_3m, ret_6m, ret_12m — one ret\\n66|      column per entry of `months`); leading rows are NaN (insufficient\\n67|      history). Deterministic: pure arithmetic + shifts on the input.\\n68|    \\\"\\\"\\\"\\n69|    if prices.empty:\\n70|        raise ValueError(\\\"rolling_returns: empty price panel\\\")\\n71|    if not months:\\n72|        raise ValueError(\\\"rolling_returns: `months` must be non-empty\\\")\\n73|    d = TRADING_DAYS_PER_MONTH\\n74|    end_shift = skip_months * d\\n75|    parts: list[pd.DataFrame] = []\\n76|    for m in months:\\n77|        ret = prices.shift(end_shift) / prices.shift(end_shift + m * d) - 1\\n78|        parts.append(_long_frame(ret, f\\\"ret_{m}m\\\"))\\n79|    out = parts[0]\\n80|    for part in parts[1:]:\\n81|        out = out.merge(part, on=[\\\"date\\\", \\\"ticker\\\"], how=\\\"inner\\\")\\n82|    return out.sort_values([\\\"date\\\", \\\"ticker\\\"]).reset_index(drop=True)\\n83|\\n84|\\n85|def cross_sectional_scores(ret: pd.DataFrame) -> pd.DataFrame:\\n86|    \\\"\\\"\\\"Per-date cross-sectional rank blend into one score column.\\n87|\\n88|    - Input: long frame from rolling_returns (date, ticker, ret_*m columns).\\n89|    - rank(pct=True) across tickers within each date (ties averaged — the\\n90|      deterministic 'average' method), blended by SCORE_WEIGHTS\\n91|      (0.5/0.3/0.2 — plan Task 7).\\n92|    - Output: long frame (date, ticker, score) with scores in [0, 1]; a date\\n93|      whose tickers all lack history scores NaN. Reproducible: two runs on the\\n94|      same input yield bit-identical frames (no timestamps, no randomness).\\n95|    \\\"\\\"\\\"\\n96|    missing = [col for col, _ in SCORE_WEIGHTS if col not in ret.columns]\\n97|    if missing:\\n98|        raise ValueError(f\\\"cross_sectional_scores: missing return columns {missing}\\\")\\n99|    if ret[[\\\"date\\\", \\\"ticker\\\"]].duplicated().any():\\n100|        raise ValueError(\\\"cross_sectional_scores: duplicate (date, ticker) rows\\\")\\n101|    ranked: dict[str, pd.Series] = {}\\n102|    for col, _ in SCORE_WEIGHTS:\\n103|        grouped = ret.groupby(\\\"date\\\", sort=False)[col]\\n104|        ranked[col] = grouped.rank(pct=True, method=\\\"average\\\")\\n105|    score = sum(weight * ranked[col] for col, weight in SCORE_WEIGHTS)\\n106|    out = pd.DataFrame({\\\"date\\\": ret[\\\"date\\\"], \\\"ticker\\\": ret[\\\"ticker\\\"]})\\n107|    out[\\\"score\\\"] = score.to_numpy()\\n108|    return out\\n109|\\n110|\\n111|def build_features(\\n112|    prices: pd.DataFrame,\\n113|    store: object,\\n114|    cfg: Settings,\\n115|) -> pd.DataFrame:\\n116|    \\\"\\\"\\\"Compute rolling_returns + cross_sectional_scores and upsert into\\n117|    Stage.FEATURES (keyed (ticker, date) — an idempotent rerun is a no-op on\\n118|    row count).\\n119|\\n120|    - `prices`: either the CLEAN long frame (ticker/date/adj_close) as the\\n121|      pipeline passes it, or a price panel (index=date, cols=ticker).\\n122|    - Returns the score frame in the wide ruling shape (SDD ledger T7):\\n123|      index=date, cols=ticker, blended score.\\n124|    \\\"\\\"\\\"\\n125|    panel = _as_panel(prices)\\n126|    ret = rolling_returns(panel, months=(3, 6, 12), skip_months=cfg.skip_months)\\n127|    scores = cross_sectional_scores(ret)\\n128|    cast(\\\"LakeStore\\\", store).write_upsert(scores, Stage.FEATURES, key_cols=(\\\"ticker\\\", \\\"date\\\"))\\n129|    wide = scores.pivot(index=\\\"date\\\", columns=\\\"ticker\\\", values=\\\"score\\\")\\n130|    return wide.sort_index()\", \"total_lines\": 130, \"file_size\": 5626, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "tool_call_id": "call_p6emwkh8", "tool_calls": null, "tool_name": "read_file", "effect_disposition": null, "timestamp": 1791474416.8302999, "token_count": null, "finish_reason": null, "reasoning": null, "reasoning_content": null, "reasoning_details": null, "codex_reasoning_items": null, "codex_message_items": null, "platform_message_id": null, "observed": 0, "active": 1, "compacted": 0, "api_content": null, "display_kind": null, "display_metadata": null, "message_uid": "5bd3cd9d4efc48559461af278aba1112", "absorbed_message_uids": null, "tool_call_uids": null, "tool_call_uid": "7da55cb1fb9a484f9bacc45acfc965d3"}, {"id": 969, "session_id": "20261008_104421_77970a", "role": "tool", "content": "{\"content\": \"1|# SDD ledger — plan: docs/superpowers/plans/2026-10-05-spx-momentum-scaffold.md\\n2|\\n3|Setup:\\n4|- Repo root already contains the full scaffold (typed placeholder interfaces;\\n5|  tests are pytest.skip stubs); executing-plans per user instruction = first real\\n6|  implementation on top of these scaffolds.\\n7|- Branch: main (user opted in to working in place; repo has no feature branches,\\n8|  worktree not requested). MERGE_BASE for final review = e3f3b72 (scaffold commit).\\n9|- Spec: DESIGN-DOC.md (read, present a