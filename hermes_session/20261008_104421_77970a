(seq), size)]\\n30|\\n31|\\n32|@dataclass(frozen=True)\\n33|class FetchRecord:\\n34|    \\\"\\\"\\\"One row of the fetch-manifest table the pipeline reports on.\\\"\\\"\\\"\\n35|\\n36|    ticker: str\\n37|    ok: bool\\n38|    rows: int\\n39|    nulls: int\\n40|    ts: datetime\\n41|    error: str | None\\n42|\\n43|\\n44|def _extract_chunk(chunk: list[str], data: object) -> dict[str, pd.DataFrame]:\\n45|    \\\"\\\"\\\"Split a yfinance `download` result into per-ticker frames.\\n46|\\n47|    Handles both response shapes:\\n48|    - MultiIndex columns `(ticker, field)` — the normal multi-ticker\\n49|      layout (group_by=\\\"ticker\\\"): one sub-frame per ticker.\\n50|    - A flat single-frame `Open/.../Close/...` — yfinance's single-ticker\\n51|      fallback (and plain-DataFrame test doubles).\\n52|\\n53|    Rows where every field is NaN are dropped; a ticker left with no valid\\n54|    rows simply has no key here.\\n55|    \\\"\\\"\\\"\\n56|    if not isinstance(data, pd.DataFrame) or data.empty:\\n57|        return {}\\n58|    frame: pd.DataFrame = data\\n59|    result: dict[str, pd.DataFrame] = {}\\n60|    columns = frame.columns\\n61|    if isinstance(columns, pd.MultiIndex):\\n62|        for ticker in chunk:\\n63|            if ticker not in columns:\\n64|                continue\\n65|            sub: pd.DataFrame = frame.loc[:, ticker].dropna(how=\\\"all\\\")\\n66|            if sub.empty:\\n67|                continue\\n68|            sub[\\\"ticker\\\"] = ticker\\n69|            result[ticker] = sub\\n70|    elif len(chunk) == 1 and \\\"Close\\\" in columns:\\n71|        sub = frame.dropna(how=\\\"all\\\")\\n72|        if sub.empty:\\n73|            return {}\\n74|        if \\\"ticker\\\" not in sub.columns:\\n75|            sub[\\\"ticker\\\"] = chunk[0]\\n76|        result[chunk[0]] = sub\\n77|    return result\\n78|\\n79|\\n80|def _normalize(frame: pd.DataFrame, ticker: str) -> pd.DataFrame:\\n81|    \\\"\\\"\\\"Coerce a per-ticker frame into the raw-stage layout:\\n82|    ticker / date / adj_close.\\n83|\\n84|    - date accepts a `date`/`Date` column or a datetime index; the result\\n85|      keeps a datelike column (LakeStore upsert normalizes to plain dates).\\n86|    - close accepts `Close`, `close`, `Adj Close` or `adj_close`; NaN stays\\n87|      NaN so it is counted as a null (dropped only if the date is\\n88|      unparseable).\\n89|    \\\"\\\"\\\"\\n90|    cols = {c: c for c in frame.columns}\\n91|    if \\\"ticker\\\" in cols and pd.api.types.is_object_dtype(frame[\\\"ticker\\\"]):\\n92|        t0 = frame[\\\"ticker\\\"].iloc[0]\\n93|        if pd.notna(t0):\\n94|            ticker = str(t0)\\n95|    if \\\"Date\\\" in cols:\\n96|        frame = frame.rename(columns={\\\"Date\\\": \\\"date\\\"})\\n97|    if \\\"date\\\" not in frame.columns:\\n98|        if frame.index.name not in (None, \\\"level_0\\\"):\\n99|            frame = frame.reset_index().rename(columns={frame.index.name: \\\"date\\\"})\\n100|        else:\\n101|            frame = frame.rename(columns={frame.columns[0]: \\\"date\\\"})\\n102|    close_src = next((c for c in (\\\"Close\\\", \\\"close\\\", \\\"Adj Close\\\", \\\"adj_close\\\") if c in frame), None)\\n103|    if close_src is None:\\n104|        raise KeyError(f\\\"no close column in {list(frame.columns)!r} for {ticker!r}\\\")\\n105|    frame = frame.rename(columns={close_src: \\\"Close\\\"})\\n106|    frame = frame.reset_index(drop=True)\\n107|    frame[\\\"date\\\"] = pd.to_datetime(frame[\\\"date\\\"], errors=\\\"coerce\\\")\\n108|    frame = frame[frame[\\\"date\\\"].notna()]\\n109|    frame[\\\"Close\\\"] = pd.to_numeric(frame[\\\"Close\\\"], errors=\\\"coerce\\\")\\n110|    frame[\\\"ticker\\\"] = ticker\\n111|    frame[\\\"adj_close\\\"] = frame[\\\"Close\\\"].astype(\\\"float64\\\")\\n112|    return frame[[\\\"ticker\\\", \\\"date\\\", \\\"adj_close\\\"]]\\n113|\\n114|\\n115|def _download_chunk(chunk: list[str], start: date, end: date) -> dict[str, pd.DataFrame]:\\n116|    \\\"\\\"\\\"One yfinance attempt for `chunk` (retry/backoff handled by caller).\\\"\\\"\\\"\\n117|    data: object = yf.download(\\n118|        chunk,\\n119|        start=start,\\n120|        end=end,\\n121|        auto_adjust=True,\\n122|        group_by=\\\"ticker\\\",\\n123|        threads=False,\\n124|        progress=False,\\n125|    )\\n126|    return _extract_chunk(chunk, data)\\n127|\\n128|\\n129|def ingest(\\n130|    tickers: pd.DataFrame,\\n131|    start: date,\\n132|    end: date,\\n133|    store: LakeStore,\\n134|    cfg: Settings,\\n135|) -> list[FetchRecord]:\\n136|    \\\"\\\"\\\"Plan Task 5 contract.\\n137|\\n138|    - Walks chunks of `cfg.fetch_chunk_size` (≈25) tickers; one dead ticker\\n139|      never aborts the batch. A ticker missing from (or failing) a chunk\\n140|      download is retried up to `cfg.fetch_retries` times total with backoff\\n141|      `cfg.fetch_backoff_s * 2**(attempt-1)` between attempts.\\n142|    - Uses adjusted-close prices (yfinance auto_adjust=True).\\n143|    - Good tickers -> store.write_upsert(..., Stage.RAW, key_cols=(\\\"ticker\\\",\\\"date\\\")).\\n144|    - Failures -> FetchRecord(ok=False, error=...); NEVER raises for one bad\\n145|      ticker; returns exactly one record per input ticker.\\n146|    \\\"\\\"\\\"\\n147|    symbols = [str(t) for t in tickers[\\\"ticker\\\"].tolist()]\\n148|    records: list[FetchRecord] = []\\n149|    for chunk in _chunked(symbols, cfg.fetch_chunk_size):\\n150|        results: dict[str, pd.DataFrame] = {}\\n151|        errors: dict[str, str] = {t: \\\"no data returned\\\" for t in chunk}\\n152|        # 1) One batch attempt for the whole chunk (~25/call).\\n153|        try:\\n154|            batch = _download_chunk(chunk, start, end)\\n155|            for ticker, frame in batch.items():\\n156|                results[ticker] = frame\\n157|                errors.pop(ticker, None)\\n158|        except Exception as exc:  # noqa: BLE001 — isolation contract: catch everything\\n159| 