n34|\\n35|\\n36|def _single_price_frame(symbol: str, start: str = \\\"2024-01-02\\\", n: int = 5) -> pd.DataFrame:\\n37|    \\\"\\\"\\\"yfinance single-ticker result: flat OHLCV columns, DateTime index.\\\"\\\"\\\"\\n38|    idx = pd.DatetimeIndex(pd.bdate_range(start, periods=n), name=\\\"Date\\\")\\n39|    rng = np.random.default_rng(1)\\n40|    arr = (100.0 + rng.normal(0.0, 1.0, (n, 5))).astype(float)\\n41|    return pd.DataFrame(arr, index=idx, columns=[\\\"Open\\\", \\\"High\\\", \\\"Low\\\", \\\"Close\\\", \\\"Volume\\\"])\\n42|\\n43|\\n44|class _FakeYF:\\n45|    \\\"\\\"\\\"Replacement for yfinance.download (patched onto ingest.yf).\\n46|\\n47|    Behavior:\\n48|    - batch call (list): returns a multi-ticker frame for the GOOD requested\\n49|      symbols only; `raise_batch` makes the whole call raise instead;\\n50|      `raise_single` makes the per-ticker retry calls raise.\\n51|    - single call (str): raises if the symbol is in `raise_single`, else a\\n52|      flat single-ticker frame.\\n53|    Records every call for assertions.\\n54|    \\\"\\\"\\\"\\n55|\\n56|    def __init__(self, raise_single: set[str] | None = None, raise_batch: bool = False) -> None:\\n57|        self.raise_single = set(raise_single or ())\\n58|        self.raise_batch = raise_batch\\n59|        self.calls: list[Any] = []\\n60|\\n61|    def download(self, tickers: Any, **kwargs: Any) -> Any:\\n62|        symbols = list(tickers) if isinstance(tickers, (list, tuple)) else [tickers]\\n63|        self.calls.append(symbols)\\n64|        if len(symbols) == 1:\\n65|            sym = symbols[0]\\n66|            if sym in self.raise_single:\\n67|                raise RuntimeError(f\\\"network blip ({sym})\\\")\\n68|            return _single_price_frame(sym)\\n69|        if self.raise_batch:\\n70|            raise RuntimeError(\\\"network blip (batch)\\\")\\n71|        good = [t for t in symbols if t not in self.raise_single]\\n72|        return _multi_price_frame(good)\\n73|\\n74|\\n75|def test_one_dead_ticker_still_returns_all_records(\\n76|    lake, monkeypatch: pytest.MonkeyPatch, tmp_path\\n77|) -> None:\\n78|    \\\"\\\"\\\"A 50-ticker batch where ticker #37 is dead: 50 records (49 ok, 1 not),\\n79|    and ingest never raises. The bad ticker's failure never takes others down.\\\"\\\"\\\"\\n80|    fake = _FakeYF(raise_single={\\\"T037\\\"})\\n81|    monkeypatch.setattr(ingest.yf, \\\"download\\\", fake.download)\\n82|    cfg = _settings(tmp_path)\\n83|    tickers = pd.DataFrame({\\\"ticker\\\": [f\\\"T{i:03d}\\\" for i in range(50)]})\\n84|    records = ingest.ingest(tickers, dt.date(2024, 1, 2), dt.date(2024, 1, 8), lake, cfg)\\n85|    assert len(records) == 50\\n86|    bad = [r for r in records if not r.ok]\\n87|    assert len(bad) == 1\\n88|    assert bad[0].ticker == \\\"T037\\\"\\n89|    assert bad[0].error and \\\"network blip\\\" in bad[0].error\\n90|    good = sorted(r.ticker for r in records if r.ok)\\n91|    assert good == sorted(set(f\\\"T{i:03d}\\\" for i in range(50)) - {\\\"T037\\\"})\\n92|\\n93|\\n94|def test_good_tickers_land_in_raw_stage(\\n95|    lake, monkeypatch: pytest.MonkeyPatch, tmp_path\\n96|) -> None:\\n97|    \\\"\\\"\\\"ok tickers (and only they) land in the raw stage, with adj_close.\\\"\\\"\\\"\\n98|    fake = _FakeYF(raise_single={\\\"BBB\\\"})\\n99|    monkeypatch.setattr(ingest.yf, \\\"download\\\", fake.download)\\n100|    cfg = _settings(tmp_path)\\n101|    tickers = pd.DataFrame({\\\"ticker\\\": [\\\"AAA\\\", \\\"BBB\\\", \\\"CCC\\\"]})\\n102|    records = ingest.ingest(tickers, dt.date(2024, 1, 2), dt.date(2024, 1, 8), lake, cfg)\\n103|    assert {r.ticker for r in records if not r.ok} == {\\\"BBB\\\"}\\n104|    raw = lake.read(Stage.RAW)\\n105|    assert set(raw[\\\"ticker\\\"]) == {\\\"AAA\\\", \\\"CCC\\\"}\\n106|    assert \\\"adj_close\\\" in raw.columns\\n107|    assert raw[\\\"adj_close\\\"].notna().all()\\n108|    for t in (\\\"AAA\\\", \\\"CCC\\\"):\\n109|        assert (\\n110|            len(raw[raw[\\\"ticker\\\"] == t]) == 5\\n111|        ), f\\\"each ticker should have 5 days of daily bars, not {len(raw[raw['ticker'] == t])}\\\"\\n112|\\n113|\\n114|def test_retry_backoff_sequence(\\n115|    lake, monkeypatch: pytest.MonkeyPatch, tmp_path\\n116|) -> None:\\n117|    \\\"\\\"\\\"A dead ticker is retried `fetch_retries` times (per-ticker singles\\n118|    after the failed batch); a good ticker is fetched once (no retry).\\\"\\\"\\\"\\n119|    fake = _FakeYF(raise_single={\\\"DEAD\\\"})\\n120|    monkeypatch.setattr(ingest.yf, \\\"download\\\", fake.download)\\n121|    cfg = _settings(tmp_path)\\n122|    tickers = pd.DataFrame({\\\"ticker\\\": [\\\"DEAD\\\", \\\"GOOD\\\"]})\\n123|    records = ingest.ingest(tickers, dt.date(2024, 1, 2), dt.date(2024, 1, 8), lake, cfg)\\n124|    by = {r.ticker: r for r in records}\\n125|    assert by[\\\"DEAD\\\"].ok is False and \\\"network blip\\\" in (by[\\\"DEAD\\\"].error or \\\"\\\")\\n126|    assert by[\\\"GOOD\\\"].ok is True\\n127|\\n128|    single_deads = [c for c in fake.calls if c == [\\\"DEAD\\\"]]\\n129|    single_goods = [c for c in fake.calls if c == [\\\"GOOD\\\"]]\\n130|    assert len(single_deads) == cfg.fetch_retries, (\\n131|        f\\\"dead ticker retried {len(single_deads)}x, want {cfg.fetch_retries}\\\"\\n132|    )\\n133|    assert len(single_goods) == 0, \\\"good ticker should not be retried\\\"\", \"total_lines\": 133, \"file_size\": 5674, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "tool_call_id": "call_jxidcqlt", "tool_calls": null, "tool_name": "read_file", "effect_disposition": null, "timestamp": 1791466730.9192097, "token_count": null, "finish_reason": null, "reasoning": null, "reasoning_content": null, "reasoning_details": null, "codex_reasoning_items": null, "codex_message_items": null, "platform_message_id": null, "observed": 0, "active": 1, "compacted": 0, "api_content": null, "display_kind": null, "display_metadata": null, "message_uid": "0c318206711