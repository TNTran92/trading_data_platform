ge\\n40|\\n41|    def write_upsert(\\n42|        self,\\n43|        df: pd.DataFrame,\\n44|        stage: Stage,\\n45|        key_cols: tuple[str, str] = (\\\"ticker\\\", \\\"date\\\"),\\n46|    ) -> Path:\\n47|        \\\"\\\"\\\"Merge `df` into the stage on `key_cols` and write parquet back out.\\n48|\\n49|        Idempotent: writing the same frame twice does not duplicate rows.\\n50|        \\\"\\\"\\\"\\n51|        df = df.copy()\\n52|        if key_cols and \\\"date\\\" in key_cols:\\n53|            df[\\\"date\\\"] = pd.to_datetime(df[\\\"date\\\"]).dt.date\\n54|            df = df[df[\\\"date\\\"].notna()]\\n55|        directory = self._stage_dir(stage)\\n56|        existing = self._read_pq(directory)\\n57|        key = [c for c in key_cols if c in existing.columns and c in df.columns]\\n58|        if existing.empty:\\n59|            merged = df\\n60|        elif not key or df.empty:\\n61|            merged = pd.concat([existing, df], ignore_index=True)\\n62|        else:\\n63|            new_keys = set(df[key].apply(tuple, axis=1))\\n64|            kept = existing[~existing[key].apply(tuple, axis=1).isin(new_keys)]\\n65|            merged = pd.concat([kept, df], ignore_index=True, sort=False)\\n66|        out = self._write_pq(merged, directory)\\n67|        self._recreate_view(stage, directory)\\n68|        return out[0] if out else directory\\n69|\\n70|    def _recreate_view(self, stage: Stage, directory: Path) -> None:\\n71|        \\\"\\\"\\\"(Re)point the stage view at its parquet files (or an empty select).\\n72|\\n73|        DuckDB rejects a glob view over an empty directory, so an unpopulated\\n74|        stage resolves to `SELECT NULL WHERE false` (zero rows, any\\n75|        count-style query still works).\\n76|        \\\"\\\"\\\"\\n77|        if sorted(directory.glob(\\\"*.parquet\\\")):\\n78|            self._conn.execute(\\n79|                f\\\"CREATE OR REPLACE VIEW {stage} AS SELECT * FROM '{directory}/*.parquet'\\\",\\n80|            )\\n81|        else:\\n82|            self._conn.execute(f\\\"CREATE OR REPLACE VIEW {stage} AS SELECT NULL WHERE false\\\")\\n83|\\n84|    def _read_pq(self, directory: Path) -> pd.DataFrame:\\n85|        files = sorted(directory.glob(\\\"*.parquet\\\"))\\n86|        if not files:\\n87|            return pd.DataFrame()\\n88|        return pd.concat([pd.read_parquet(f) for f in files], ignore_index=True, sort=False)\\n89|\\n90|    def _write_pq(self, df: pd.DataFrame, directory: Path) -> list[Path]:\\n91|        out: list[Path] = []\\n92|        files = sorted(directory.glob(\\\"*.parquet\\\"))\\n93|        if files:\\n94|            for f in files:\\n95|                f.unlink()\\n96|        if df.empty:\\n97|            return out\\n98|        out_path = directory / \\\"stage.parquet\\\"\\n99|        df.reset_index(drop=True).to_parquet(out_path)\\n100|        out.append(out_path)\\n101|        return out\\n102|\\n103|    def read(self, stage: Stage) -> pd.DataFrame:\\n104|        \\\"\\\"\\\"SELECT * over the stage's Parquet files (empty frame if none).\\\"\\\"\\\"\\n105|        directory = self._stage_dir(stage)\\n106|        files = sorted(directory.glob(\\\"*.parquet\\\"))\\n107|        if not files:\\n108|            return pd.DataFrame()\\n109|        return pd.concat([pd.read_parquet(f) for f in files], ignore_index=True, sort=False)\\n110|\\n111|    def sql(self, query: str) -> pd.DataFrame:\\n112|        \\\"\\\"\\\"Run DuckDB SQL (stage names resolve as views); return a DataFrame.\\\"\\\"\\\"\\n113|        return self._conn.execute(query).fetchdf()\\n114|\\n115|    def close(self) -> None:\\n116|        self._conn.close()\\n117|\", \"total_lines\": 117, \"file_size\": 4305, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "tool_call_id": "call_q2t8a61w", "tool_calls": null, "tool_name": "read_file", "effect_disposition": null, "timestamp": 1791388563.3820336, "token_count": null, "finish_reason": null, "reasoning": nul