ling the math.\\\"\\\"\\\"\\n    return int(np.clip(150 - (t - (skip + m) * D), 0, 100)) - int(\\n        np.clip(150 - (t - skip * D), 0, 100)\\n    )\\n\\n\\ndef test_skip_month_boundary() -\\u003e None:\\n    \\\"\\\"\\\"rolling_returns must exclude the most recent month of each window:\\n    for growth confined to rows [50,150), ret_m(t) == g^{in-band rows} - 1 and\\n    the hand-rolled value at t=250, skip=1 is NOT equal to skip=0.\\\"\\\"\\\"\\n    px = _skip_sensitive_prices()\\n    rets = rolling_returns(px, months=(3, 6, 12), skip_months=1)\\n    t = 250\\n    row = rets[(rets[\\\"date\\\"] == px.index[t]) \\u0026 (rets[\\\"ticker\\\"] == \\\"AAA\\\")]\\n    assert len(row) == 1\\n    g = 1.01\\n    for m in (3, 6, 12):\\n        expected = g ** _band_count(t, skip=1, m=m) - 1.0\\n        assert float(row[f\\\"ret_{m}m\\\"].iloc[0]) == pytest.approx(expected, rel=1e-12)\\n    # Proof the skip is real: skip_months=0 puts a whole extra month (21\\n    # rows) of the band into the window — the values must differ.\\n    plain = rolling_returns(px, months=(3, 6, 12), skip_months=0)\\n    plain_row = plain[(plain[\\\"date\\\"] == px.index[t]) \\u0026 (plain[\\\"ticker\\\"] == \\\"AAA\\\")]\\n    for m in (3, 6, 12):\\n        unskipped = g ** _band_count(t, skip=0, m=m) - 1.0\\n        assert unskipped != float(row[f\\\"ret_{m}m\\\"].iloc[0])\\n        assert _band_count(t, 0, m) == _band_count(t, 1, m) + 21  # one full month\\n    # Leading rows (insufficient history) are NaN.\\n    first = rets[rets[\\\"ticker\\\"] == \\\"AAA\\\"].iloc[0]\\n    assert pd.isna(first[\\\"ret_3m\\\"]) and pd.isna(first[\\\"ret_12m\\\"])\\n\\n\\ndef test_scores_per_date_cross_section() -\\u003e None:\\n    \\\"\\\"\\\"Scores are a per-date cross-section: within each date all 5 rank spots\\n    appear (min 0.2, max 1.0 — n=5 tickers), AAA strictly outranks EEE.\\\"\\\"\\\"\\n    px = _skip_sensitive_prices()\\n    rets = rolling_returns(px)\\n    scores = cross_sectional_scores(rets